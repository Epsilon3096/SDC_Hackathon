# Local development works without secrets. Do not commit a real .env.
HOST=127.0.0.1
PORT=3001
# Hosted Replit deployments must set DATABASE_URL through Secrets.
# DATABASE_URL=postgresql://...
# ADMIN_TOKEN=generate-a-random-team-review-token
# DEMO_REVIEW=true enables review only inside isolated synthetic demo workspaces.
# It never enables paid RunPod requests. Leave false for a controlled review service.
# PUBLIC_ORIGIN=https://your-published-app.replit.app
# NODE_ENV=production
# Optional and currently deferred: RunPod is not required for local operation.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_MODEL_REVISION=40-character-huggingface-commit-sha
