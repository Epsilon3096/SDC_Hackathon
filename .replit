run = "npm run replit"
entrypoint = "src/server/index.ts"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_11"

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "NODE_ENV=production HOST=0.0.0.0 DEMO_REVIEW=true npm start"]
build = ["sh", "-c", "npm ci && npm run build"]

[[ports]]
localPort = 3001
externalPort = 80
